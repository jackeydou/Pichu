{
  "name": "pichu-client",
  "productName": "Pichu",
  "version": "2026.6.2400",
  "description": "Pichu desktop client for AI-assisted workflows.",
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "author": "Pichu",
  "scripts": {
    "build:workspace-deps": "pnpm --filter @pichu/mac-window-list build && pnpm --filter @pichu/mac-input build && pnpm --filter @pichu/mac-cursor-overlay build && pnpm --filter @pichu/mac-process-limits build",
    "build:workspace-deps:with-node": "pnpm run prepare:node-runtime && pnpm run build:workspace-deps",
    "generate:menu-bar-icons": "node scripts/generate-menu-bar-icons.mjs",
    "prepare:node-runtime": "node scripts/prepare-node-runtime.mjs",
    "prepare:computer-use-helper": "node scripts/prepare-computer-use-helper.mjs",
    "lint": "cd ../.. && biome check apps/pichu-client packages",
    "format": "cd ../.. && biome format --write apps/pichu-client packages",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test:admin": "pnpm run build && node --experimental-strip-types --test tests/admin/*.test.mjs",
    "test:plugins": "pnpm run build:workspace-deps && pnpm run build && node --experimental-strip-types --test tests/plugins/*.test.mjs",
    "validate:plugin": "node --experimental-strip-types scripts/validate-plugin.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --port 4984",
    "postinstall": "electron-builder install-app-deps && electron-rebuild -o better-sqlite3,node-pty",
    "prestart": "pnpm run build:workspace-deps",
    "start": "electron-vite preview",
    "predev": "pnpm run build:workspace-deps",
    "dev": "node scripts/dev.mjs",
    "dev:unpack": "pnpm run build:unpack && open dist/mac-arm64/Pichu.app",
    "build": "pnpm run typecheck && electron-vite build",
    "build:unpack": "pnpm run build:workspace-deps:with-node && pnpm run build && pnpm run prepare:computer-use-helper && electron-builder --dir --config scripts/electron-builder-config.cjs",
    "build:win": "pnpm run build:workspace-deps && pnpm run build && electron-builder --win --config scripts/electron-builder-config.cjs",
    "build:mac": "node scripts/build-mac.mjs --release",
    "build:mac:debug": "node scripts/build-mac.mjs --debug",
    "build:mac:local": "node scripts/build-mac.mjs --debug --skip-notarize",
    "build:mac:local:install": "node scripts/build-mac.mjs --debug --skip-notarize --install",
    "build:linux": "pnpm run build:workspace-deps && pnpm run build && electron-builder --linux --config scripts/electron-builder-config.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.71",
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@floating-ui/react-dom": "^2.1.8",
    "@json-render/core": "0.19.0",
    "@json-render/react": "0.19.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@pichu/mac-cursor-overlay": "workspace:*",
    "@pichu/mac-input": "workspace:*",
    "@pichu/mac-process-limits": "workspace:*",
    "@pichu/mac-window-list": "workspace:*",
    "@pichu/session-inspector": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "front-matter": "^4.0.2",
    "gridstack": "^12.6.0",
    "i18next": "^26.0.8",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "ms": "^2.1.3",
    "node-cron": "^4.2.1",
    "node-pty": "^1.1.0",
    "prosemirror-state": "1.4.4",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.6",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "shell-quote": "^1.10.0",
    "shiki": "^4.1.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "trash": "^10.1.1",
    "typebox": "^1.3.12",
    "ws": "^8.21.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.0",
    "@libsql/client": "^0.15.15",
    "@react-scan/vite-plugin-react-scan": "^0.2.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "electron": "41.10.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "node-abi": "^4.33.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-scan": "^0.5.7",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  }
}
