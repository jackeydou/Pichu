{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/user-prompt-submit.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-use.js"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/permission-request.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-tool-use.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/stop.js"
          }
        ]
      }
    ]
  }
}
