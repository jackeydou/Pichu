{
  "name": "@pichu/mac-input",
  "version": "0.1.0",
  "description": "Synthesize mouse and keyboard events on macOS via CGEvent. Internal Pichu package.",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "mac-input",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:universal": "napi build --platform --release --target universal-apple-darwin",
    "prepublishOnly": "napi prepublish --skip-gh-release"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2"
  }
}
